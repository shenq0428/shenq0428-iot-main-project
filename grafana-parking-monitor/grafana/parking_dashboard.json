          "rawQuery": true,
          "rawSql": "SELECT \r\n  -- 1. 直接在这里拼好名字，作为第一列\r\n  CONCAT('Floor ', floor) AS \"Location\", \r\n  -- 2. 数值作为第二列\r\n  COUNT(*) AS \"Number of spaces\"\r\nFROM parking_sensor_data\r\nWHERE \r\n  timestamp = (\r\n      SELECT MAX(timestamp) \r\n      FROM parking_sensor_data \r\n      WHERE timestamp <= NOW()\r\n  )\r\n  AND status = 0\r\nGROUP BY floor\r\nORDER BY floor ASC;",
