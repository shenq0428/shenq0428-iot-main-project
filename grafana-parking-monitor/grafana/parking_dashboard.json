          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \r\n  -- 强制减去 8 小时，抵消浏览器 (UTC+08:00) 导致的二次偏移\r\n  DATE_SUB(timestamp, INTERVAL 8 HOUR) AS time, \r\n  status AS 'status', \r\n  CONCAT('F', floor, ' - S', LPAD(space_id, 2, '0')) AS space_id_with_floor\r\nFROM parking_sensor_data \r\n-- 使用 $__timeFilter 更简洁，且能完美配合右上角的时间选择器\r\nWHERE $__timeFilter(timestamp)\r\nORDER BY time ASC, floor ASC, CAST(space_id AS UNSIGNED) ASC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
