          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \r\n  DATE_SUB(timestamp, INTERVAL 8 HOUR) AS time, \r\n  COUNT(*) AS value\r\nFROM parking_sensor_data\r\nWHERE \r\n  -- 核心逻辑：找数据库里“最接近现在”但不超过现在的数据\r\n  timestamp = (\r\n      SELECT MAX(timestamp) \r\n      FROM parking_sensor_data \r\n      WHERE timestamp <= NOW() -- 强制要求时间不能超过当前现实时刻\r\n  )\r\n  AND status = 0;",
          "refId": "A",
